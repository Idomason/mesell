{
  "name": "mesell-monorepo",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @workspace/frontend dev",
    "dev:backend": "pnpm --filter @workspace/backend dev",
    "dev": "pnpm dev:frontend & pnpm dev:backend",
    "build:ui": "pnpm --filter @workspace/ui build",
    "build:shared": "pnpm --filter @workspace/shared build",
    "build:frontend": "pnpm --filter @workspace/frontend build",
    "build:backend": "pnpm --filter @workspace/backend build",
    "build": "pnpm --filter ... build"
  }
}
