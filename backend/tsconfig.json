{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@/*": ["./src/*"],
      "mesell-shared": ["../shared/src/index.ts"],
      "mesell-shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "src/server.ts", "src/app.ts", "../shared/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
